EXTRA_RUNS += run-test-thead-c900-clint
test-thead-c900-clint: test-thead-c900-clint.o
run-test-thead-c900-clint: test-thead-c900-clint
	$(call run-test, $<, $(QEMU) -M beaglev-ahead -display none \
